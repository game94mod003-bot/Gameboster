<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/st_off"
        android:textColor="#FFC83D" android:textSize="22sp" android:gravity="center"
        android:paddingBottom="16dp" />
    <EditText android:id="@+id/config" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:hint="@string/hint" android:gravity="top|start"
        android:textColor="#FFFFFF" android:textColorHint="#777777"
        android:typeface="monospace" android:textSize="12sp"
        android:inputType="textMultiLine|textNoSuggestions" android:textDirection="ltr" />
    <Button android:id="@+id/toggle" android:layout_width="match_parent"
        android:layout_height="72dp" android:text="@string/connect"
        android:textColor="#0A0A0F" android:textSize="20sp"
        android:backgroundTint="#1F6BFF" android:layout_marginTop="12dp" />
</LinearLayout>
